# Google Sheets
GOOGLE_SHEET_ID=11Z4m5MKXFxb4TgRdUpO9diZncI1NdOkFwxWkr501H40
GOOGLE_SHEET_NAME=infoData
TEMPLATE_USER_SHEET_NAME=account_data_template
ACCOUNT_DATA_TEMPLATE=account_data_template
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./opiumboost-d5de29320e91.json
# Optional: paste JSON credentials (single line) if not using file path
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=

# Security headers
CSP_GOOGLE_APIS="https://sheets.googleapis.com https://www.googleapis.com https://*.googleapis.com"
CSP_ADDITIONAL_DOMAINS=
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=86400
CORS_ALLOWED_METHODS="GET, POST, PUT, PATCH, DELETE, OPTIONS"
CORS_ALLOWED_HEADERS="Content-Type, Authorization, X-CSRF-Token, X-Requested-With"
CORS_EXPOSED_HEADERS="X-CSRF-Token"

# Rate limiting
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW_MINUTES=5
RATE_LIMIT_AUTH_MESSAGE="Too many authentication attempts. Please try again later."
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_MINUTES=15
RATE_LIMIT_API_MESSAGE="Too many requests. Please try again later."
RATE_LIMIT_GENERAL_MAX=200
RATE_LIMIT_GENERAL_WINDOW_MINUTES=15
RATE_LIMIT_GENERAL_MESSAGE="Too many requests. Please try again later."

# Build info (auto-generated in next.config.ts, these are fallbacks)
NEXT_PUBLIC_VERSION=0.1.1
NEXT_PUBLIC_COMMIT_ID=dev

